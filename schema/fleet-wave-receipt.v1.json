{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fleet-wave-receipt.v1.json",
  "title": "Fleet Wave receipt v1",
  "type": "object",
  "required": ["schema_version", "event", "protocol_version", "receipt_id", "receipt_type", "authority", "work_id", "beads_issue_version", "claim_id", "attempt_id", "manifest_version", "manifest_digest", "predecessor", "actor", "timestamps", "transition", "result", "reason_code", "evidence", "stage_extension", "integrity"],
  "properties": {
    "schema_version": {"const": "fleet-wave.v1"},
    "event": {"type": "string", "minLength": 1},
    "protocol_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "receipt_type": {"type": "string", "minLength": 1},
    "authority": {"$ref": "#/$defs/authority"},
    "work_id": {"type": "string", "minLength": 1},
    "beads_issue_version": {"type": "string", "minLength": 1},
    "claim_id": {"type": ["string", "null"]},
    "attempt_id": {"type": "string", "minLength": 1},
    "manifest_version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor": {"$ref": "#/$defs/predecessor"},
    "actor": {"$ref": "#/$defs/actor"},
    "timestamps": {"type": "object", "additionalProperties": false, "required": ["started_at", "ended_at"], "properties": {"started_at": {"type": "string"}, "ended_at": {"type": "string"}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}},
    "result": {"enum": ["PASS", "BLOCKED", "DEGRADED"]},
    "reason_code": {"type": ["string", "null"]},
    "evidence": {"type": "array"},
    "stage_extension": {"type": "object"},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["digest", "attestation_type", "attested_by"], "properties": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "attestation_type": {"const": "sha256-non-cryptographic"}, "attested_by": {"const": "fleet-wave-controller"}}},
    "check_execution": {"type": "object", "additionalProperties": {"$ref": "#/$defs/e3"}}
  },
  "allOf": [{"if": {"properties": {"event": {"const": "accepted"}}, "required": ["event"]}, "then": {"required": ["check_execution"]}}],
  "unevaluatedProperties": true,
  "$defs": {
    "authority": {"type": "object", "additionalProperties": false, "required": ["issue_id", "authority_host", "store_locator", "claimant", "digest"], "properties": {"issue_id": {"type": "string"}, "authority_host": {"type": "string"}, "store_locator": {"type": "string"}, "claimant": {"type": "string"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "digest"], "properties": {"receipt_id": {"type": ["string", "null"]}, "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["identity", "role", "service", "host", "execution_id", "session_id", "model", "attestation"], "properties": {"identity": {"type": "string"}, "role": {"type": "string"}, "service": {"type": "string"}, "host": {"type": "string"}, "execution_id": {"type": "string"}, "session_id": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "attestation": {"type": "object"}}},
    "e3": {"type": "object", "additionalProperties": false, "required": ["command", "exit_status", "tool_versions", "environment_digest", "machine_result", "stdout_sha256", "stderr_sha256"], "properties": {"command": {"type": "string"}, "exit_status": {"const": 0}, "tool_versions": {"type": "object"}, "environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "machine_result": {"const": "PASS"}, "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}

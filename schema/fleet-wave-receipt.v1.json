{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fleet-wave-receipt.v1.json",
  "title": "Fleet Wave receipt v1",
  "type": "object",
  "required": ["schema_version", "protocol_version", "receipt_id", "receipt_type", "authority", "work_id", "beads_issue_version", "claim_id", "attempt_id", "manifest_version", "manifest_digest", "predecessor", "actor", "timestamps", "transition", "result", "reason_code", "evidence", "stage_extension", "integrity"],
  "properties": {
    "schema_version": {"const": "fleet-wave.v1"},
    "protocol_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "receipt_type": {"type": "string", "minLength": 1},
    "authority": {"$ref": "#/$defs/authority"},
    "work_id": {"type": "string", "minLength": 1},
    "beads_issue_version": {"type": ["string", "integer"]},
    "claim_id": {"type": ["string", "null"]},
    "attempt_id": {"type": "string", "minLength": 1},
    "manifest_version": {"type": ["string", "null"], "pattern": "^v[1-9][0-9]*$"},
    "manifest_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "predecessor": {"$ref": "#/$defs/predecessor"},
    "actor": {"$ref": "#/$defs/actor"},
    "timestamps": {"type": "object", "additionalProperties": false, "required": ["started_at", "ended_at"], "properties": {"started_at": {"type": "string", "minLength": 1}, "ended_at": {"type": "string", "minLength": 1}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}}},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED", "DEGRADED", "NOT_APPLICABLE"]},
    "reason_code": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "stage_extension": {"type": "object"},
    "integrity": {"$ref": "#/$defs/integrity"},
    "check_execution": {"type": "object", "additionalProperties": {"$ref": "#/$defs/check_execution"}}
  },
  "unevaluatedProperties": true,
  "$defs": {
    "authority": {"type": "object", "additionalProperties": false, "required": ["issue_id", "authority_host", "store_locator", "claimant", "digest"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "authority_host": {"type": "string", "minLength": 1}, "store_locator": {"type": "string", "minLength": 1}, "claimant": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "digest"], "properties": {"receipt_id": {"type": ["string", "null"]}, "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["identity", "role", "service", "host", "execution_id", "session_id", "model", "attestation"], "properties": {"identity": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "service": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}, "execution_id": {"type": "string", "minLength": 1}, "session_id": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "attestation": {"type": "object"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["class", "uri", "digest", "size_bytes", "provenance", "observed_at", "freshness"], "properties": {"class": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]}, "uri": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}, "provenance": {"type": "object"}, "observed_at": {"type": "string", "minLength": 1}, "freshness": {"type": ["string", "object"]}}},
    "check_execution": {"type": "object", "additionalProperties": false, "required": ["command", "exit_status", "tool_check_versions", "environment_digest", "machine_readable_result", "raw_output_digest"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exit_status": {"type": "integer"}, "tool_check_versions": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "machine_readable_result": {"type": "object"}, "raw_output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["digest", "attestation_type", "attested_by"], "properties": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "attestation_type": {"const": "sha256-non-cryptographic"}, "attested_by": {"const": "fleet-wave-controller"}}}
  }
}

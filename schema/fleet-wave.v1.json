{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fleet-wave.v1.json",
  "title": "Fleet Wave manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "wave_id", "supersedes", "ringer_manifest", "beads", "tasks"],
  "properties": {
    "schema_version": {"const": "fleet-wave.v1"},
    "manifest_version": {"type": "integer", "minimum": 1},
    "wave_id": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "run_name": {"type": "string"},
    "workdir": {"type": "string"},
    "max_parallel": {"type": "integer", "minimum": 1},
    "ringer_manifest": {"type": "string", "minLength": 1},
    "beads": {"$ref": "#/$defs/beads"},
    "paperclip": {"$ref": "#/$defs/paperclip"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "beads": {"type": "object", "additionalProperties": false, "required": ["claim_id", "existing_ids"], "properties": {"claim_id": {"type": "string", "minLength": 1}, "existing_ids": {"$ref": "#/$defs/ids"}}},
    "paperclip": {"type": "object", "additionalProperties": false, "required": ["issue_id", "existing_ids"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "existing_ids": {"$ref": "#/$defs/ids"}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["key", "work_type", "evidence"], "properties": {"key": {"type": "string", "minLength": 1}, "work_type": {"enum": ["code", "deployment", "config", "factual-research", "other"]}, "spec": {"type": "string"}, "check": {"type": "string"}, "expect_files": {"type": "array", "items": {"type": "string"}}, "verified": {"type": "string"}, "evidence": {"type": "object", "additionalProperties": false, "required": ["strength", "kind"], "properties": {"strength": {"const": "strong"}, "kind": {"enum": ["objective", "judgmental"]}}}}}
  }
}
